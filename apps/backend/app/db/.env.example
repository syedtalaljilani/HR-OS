# Copy to `app/db/.env` and fill in real values. Never commit the real .env.

# --- Database (PostgreSQL + pgvector via docker-compose) ---
DATABASE_URL=postgresql+psycopg://hr:1234@localhost:5432/hr_recruitment

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Storage ---
UPLOAD_DIR=storage/uploads
MAX_CV_SIZE_MB=10

# --- Ollama (local LLM runtime) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=10m
# General + evaluation model (Qwen3-8B Q4).
OLLAMA_MODEL=qwen3:latest
OLLAMA_EVALUATION_MODEL=qwen3:latest
# Optional second pass for ambiguous (UNCLEAR) screenings. Empty = disabled.
OLLAMA_FALLBACK_EVALUATION_MODEL=
# Optional faster/smaller CV parsing model. Empty = use OLLAMA_MODEL.
OLLAMA_PROFILE_MODEL=
# Tiny email-drafting model. Pull with: ollama pull qwen3:1.7b
EMAIL_MODEL=qwen3:1.7b
# CV OCR + embeddings (via Ollama).
OCR_MODEL=deepseek-ocr
EMBEDDING_MODEL=all-minilm

# --- Candidate-facing links ---
PUBLIC_BASE_URL=http://localhost:3000

# --- Email agent ---
EMAIL_ENABLED=true
REPLY_AGENT_ENABLED=true
REPLY_AGENT_INTERVAL_SECONDS=60
MISSED_INTERVIEW_GRACE_MINUTES=15

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.gmail.account@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password
SMTP_FROM=your.gmail.account@gmail.com
SMTP_FROM_NAME=Your Company

IMAP_ENABLED=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your.gmail.account@gmail.com
IMAP_PASSWORD=your-16-char-gmail-app-password
IMAP_FOLDER=INBOX

# --- Application routing / screening ---
AUTO_EVALUATE_ON_APPLY=true
AUTO_REJECT_THRESHOLD=40
AUTO_REJECT_FLOOR=20
AUTO_SCREEN_TIMEOUT_SECONDS=360
TRACKING_TOKEN_EXPIRE_DAYS=90

# --- Talent pool ---
TALENT_POOL_INVITES_ON_PUBLISH=true
TALENT_POOL_INVITE_DAYS=14

# --- Org identity (also editable from the dashboard Settings page) ---
COMPANY_NAME=Your Company
HR_NAME=Your Name
COMPANY_LOCATION=